    }
  ],
  "fields": [
    {
      "key": "owner_name",
      "label": "Owner Name",
      "prompt": "What is your full name?",
      "type": "string",
      "required": true,
      "filled_by": "applicant"
    },
    {
      "key": "date_filed",
      "label": "Date of Application",
      "prompt": null,
      "type": "date",
      "required": true,
      "filled_by": "auto"
    },
    {
      "key": "owner_ssn",
      "label": "SSN",
      "prompt": "What is your SSN?",
      "type": "string",
      "required": true,
      "filled_by": "applicant"
    },
    {
      "key": "vehicle_vin_location",
      "label": "Vehicle VIN & Location",
      "prompt": "What is the vehicle's VIN, and where is it currently located?",
      "type": "string",
      "required": true,
      "filled_by": "applicant"
    },
    {
      "key": "proof_of_ownership",
      "label": "Proof Of Ownership",
      "prompt": "Provide proof of ownership (registration details, purchase record, etc.)",
      "type": "text",
      "required": true,
      "filled_by": "applicant"
    },
    {
      "key": "reason_for_request",
      "label": "Reason for Request",
      "prompt": "Why are you requesting the return of this vehicle?",
      "type": "text",
      "required": true,
      "filled_by": "applicant"
    },
    {
      "key": "approving_judge_name",
      "label": "Approving LEO or Judiciary",
      "prompt": null,
      "type": "signature",
      "required": true,
      "filled_by": "judge",
      "note": "Rendered in cursive. Filled in by the bot when an LEO/judge approves the return — never asked of the applicant."
    },
    {
      "key": "approval_date",
      "label": "Date",
      "prompt": null,
      "type": "date",
      "required": true,
      "filled_by": "auto"
    }
